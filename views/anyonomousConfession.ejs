<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Campus Confessions (Campus Connect)</title>
  <link rel="stylesheet" href="/src/output.css">
  <script src="/socket.io/socket.io.js"></script>
  <style>
    .confession-card { animation: popIn 0.25s ease both; }
    @keyframes popIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  </style>
</head>

<body class="h-screen h-[100vh] h-[100dvh] h-[100svh] w-full flex items-center justify-start container m-auto flex-col relative max-w-3xl bg-gray-50 overflow-hidden">

  <!-- ── TOP BAR ───────────────────────────────────────────────────────────── -->
  <header class="h-16 flex flex-row items-center justify-between w-full z-50 bg-white max-w-3xl px-4 border-b border-gray-200 flex-shrink-0">
    <div class="flex items-center gap-2">
      <a href="/" class="p-2 rounded-full hover:bg-gray-100 transition-colors" title="Back to Feed">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
      </a>
      <div class="flex items-center gap-1.5">
        <h1 class="text-lg font-bold text-gray-900">Campus Confessions</h1>
        <span class="px-2 py-0.5 rounded-full bg-[#f4ff26] text-[10px] font-bold text-gray-800">100% Anonymous</span>
      </div>
    </div>

    <div class="text-xs text-gray-400 italic">No names attached</div>
  </header>

  <!-- ── CONFESSIONS STREAM ────────────────────────────────────────────────── -->
  <main id="chattingarea" class="flex-1 w-full overflow-y-auto p-4 flex flex-col gap-3 max-w-2xl">
    <!-- Notice Banner -->
    <div class="p-3 bg-amber-50 border border-amber-200 rounded-2xl flex items-center gap-2 text-xs text-amber-800">
      <span>🤫</span>
      <span>Be respectful! Posts are visible to all students across campus.</span>
    </div>

    <% chatarray.forEach(element => { %>
      <div class="confession-card bg-white p-4 rounded-2xl border border-gray-200 shadow-sm flex items-start justify-between gap-3">
        <div class="flex items-start gap-3 flex-1">
          <div class="w-9 h-9 rounded-full bg-gray-100 flex items-center justify-center flex-shrink-0 text-base">
            🕵️
          </div>
          <div class="flex flex-col flex-1">
            <span class="text-sm text-gray-800 leading-relaxed font-normal"><%= element.message %></span>
            <span class="text-[10px] text-gray-400 mt-1">
              <%= element.timestamp ? new Date(element.timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : 'Recently' %>
            </span>
          </div>
        </div>

        <!-- Upvote -->
        <button onclick="upvoteMessage('<%= element._id %>', this)" 
          class="flex items-center gap-1 px-2.5 py-1 rounded-full bg-gray-100 hover:bg-[#f4ff26] text-xs font-semibold text-gray-700 transition-colors flex-shrink-0">
          <span>▲</span>
          <span class="upvote-count"><%= element.upvotes || 0 %></span>
        </button>
      </div>
    <% }) %>
  </main>

  <!-- ── CONFESSION INPUT ──────────────────────────────────────────────────── -->
  <footer class="w-full p-3 pb-14 sm:pb-3 bg-white border-t border-gray-200 flex-shrink-0 max-w-3xl sticky bottom-0 z-10">
    <form id="confessionForm" class="flex items-center gap-2">
      <input id="message" type="text" placeholder="Share an anonymous confession or thought..." 
        class="flex-1 px-4 py-2.5 rounded-full bg-gray-100 text-sm focus:outline-none focus:ring-2 focus:ring-[#bee84a] text-gray-900" required>
      <button type="submit" 
        class="px-5 py-2.5 bg-gradient-to-r from-[#f4ff26] to-[#bee84a] rounded-full text-xs font-bold text-gray-900 shadow hover:opacity-90 transition-opacity flex-shrink-0">
        Confess
      </button>
    </form>
  </footer>

  <script src="/js/anyonomousConfession.js"></script>
</body>
</html>