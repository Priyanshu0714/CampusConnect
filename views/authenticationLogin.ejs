<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login (Campus Connect)</title>
  <link rel="stylesheet" href="/src/output.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>

<body class="h-screen w-full flex container m-auto flex-col relative max-w-3xl items-center justify-center p-4">

  <div class="flex-1 flex items-center justify-center flex-col w-full">
    <form class="form_container max-w-sm w-full" method="post" action="/authentication/">
      <div class="logo_container flex flex-row gap-1 items-center justify-center w-full h-full">
        <img class="object-contain h-12" src="/images/newlogo.svg" alt="Campus Connect">
      </div>
      <div class="title_container">
        <p class="title">Login to Campus Connect</p>
        <span class="subtitle">Connect with classmates, events, stories, and conversations across campus.</span>
      </div>

      <!-- Error notification banner -->
      <div id="ifincorrect" class="hidden w-full p-2.5 rounded-xl bg-rose-50 border border-rose-200 text-rose-600 text-xs font-semibold text-center">
        Invalid username or password
      </div>

      <!-- Username field -->
      <div class="input_container w-full">
        <label class="input_label" for="username">Username</label>
        <svg fill="none" viewBox="0 0 24 24" height="20" width="20" xmlns="http://www.w3.org/2000/svg" class="icon">
          <path stroke-linejoin="round" stroke-linecap="round" stroke-width="1.5" stroke="#141B34" d="M7 8.5L9.94202 10.2394C11.6572 11.2535 12.3428 11.2535 14.058 10.2394L17 8.5"></path>
          <path stroke-linejoin="round" stroke-width="1.5" stroke="#141B34" d="M2.01577 13.4756C2.08114 16.5412 2.11383 18.0739 3.24496 19.2094C4.37608 20.3448 5.95033 20.3843 9.09883 20.4634C11.0393 20.5122 12.9607 20.5122 14.9012 20.4634C18.0497 20.3843 19.6239 20.3448 20.7551 19.2094C21.8862 18.0739 21.9189 16.5412 21.9842 13.4756C22.0053 12.4899 22.0053 11.5101 21.9842 10.5244C21.9189 7.45886 21.8862 5.92609 20.7551 4.79066C19.6239 3.65523 18.0497 3.61568 14.9012 3.53657C12.9607 3.48781 11.0393 3.48781 9.09882 3.53656C5.95033 3.61566 4.37608 3.65521 3.24495 4.79065C2.11382 5.92608 2.08114 7.45885 2.01576 10.5244C1.99474 11.5101 1.99475 12.4899 2.01577 13.4756Z"></path>
        </svg>
        <input placeholder="Your username" name="username" type="text" class="input_field" id="username" required autocomplete="username">
      </div>

      <!-- Password field with eye toggle -->
      <div class="input_container w-full relative">
        <label class="input_label" for="password_field">Password</label>
        <svg fill="none" viewBox="0 0 24 24" height="20" width="20" xmlns="http://www.w3.org/2000/svg" class="icon">
          <path stroke-linecap="round" stroke-width="1.5" stroke="#141B34" d="M18 11.0041C17.4166 9.91704 16.273 9.15775 14.9519 9.0993C13.477 9.03404 11.9788 9 10.329 9C8.67911 9 7.18091 9.03404 5.70604 9.0993C3.95328 9.17685 2.51295 10.4881 2.27882 12.1618C2.12602 13.2541 2 14.3734 2 15.5134C2 16.6534 2.12602 17.7727 2.27882 18.865C2.51295 20.5387 3.95328 21.8499 5.70604 21.9275C6.42013 21.9591 7.26041 21.9834 8 22"></path>
          <path stroke-linejoin="round" stroke-linecap="round" stroke-width="1.5" stroke="#141B34" d="M6 9V6.5C6 4.01472 8.01472 2 10.5 2C12.9853 2 15 4.01472 15 6.5V9"></path>
        </svg>
        <input placeholder="Password" name="password" type="password" class="input_field pr-10" id="password_field" required autocomplete="current-password">
        
        <!-- Toggle button -->
        <button type="button" id="togglePassword" class="absolute right-3 bottom-2 text-gray-400 hover:text-gray-700 focus:outline-none">
          <svg id="eyeIcon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
            <circle cx="12" cy="12" r="3"></circle>
          </svg>
        </button>
      </div>

      <button id="submitBtn" title="Sign In" type="submit" class="sign-in_btn font-bold text-sm">
        <span id="btnText">Sign In</span>
      </button>

      <div class="separator">
        <hr class="line">
        <span>Or</span>
        <hr class="line">
      </div>

      <button id="signup" title="Create an account" type="button" class="sign-in_ggl font-bold text-sm">
        Create New Account
      </button>
    </form>
  </div>

  <script src="/js/authenticationFrontendLogin.js"></script>
</body>
</html>