<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Notifications — Campus Connect</title>
  <link rel="stylesheet" href="/src/output.css">
  <style>
    .notif-card { transition: all 0.2s ease; }
    .notif-card:hover { transform: translateY(-1px); }
  </style>
</head>

<body class="min-h-screen w-full flex items-center justify-start container m-auto flex-col relative max-w-3xl bg-gray-50 pb-24">

  <!-- ── TOP BAR ───────────────────────────────────────────────────────────── -->
  <header class="h-16 fixed top-0 flex flex-row items-center justify-between w-full z-50 bg-white max-w-3xl px-4 border-b border-gray-200">
    <div class="flex items-center gap-3">
      <a href="/" class="p-2 rounded-full hover:bg-gray-100 transition-colors" title="Back to Home">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
      </a>
      <h1 class="text-xl font-bold text-gray-900">Notifications</h1>
    </div>
    <div class="text-xs px-2.5 py-1 rounded-full bg-[#f4ff26] font-semibold text-gray-800">
      <%= notifications.length %> total
    </div>
  </header>

  <!-- ── NOTIFICATIONS LIST ────────────────────────────────────────────────── -->
  <main class="w-full mt-20 px-3 flex flex-col gap-2 max-w-2xl">
    <% if (notifications.length === 0) { %>
      <div class="mt-16 flex flex-col items-center justify-center text-center p-8 bg-white rounded-2xl border border-gray-200 shadow-sm">
        <div class="w-16 h-16 rounded-full bg-[#f4ff26]/40 flex items-center justify-center mb-3">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
            <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
          </svg>
        </div>
        <h2 class="text-lg font-bold text-gray-800">All caught up!</h2>
        <p class="text-sm text-gray-500 mt-1 max-w-xs">When someone likes your posts, leaves a comment, or follows you, you'll see updates here.</p>
        <a href="/" class="mt-4 px-5 py-2 bg-gradient-to-r from-[#f4ff26] to-[#bee84a] rounded-full text-xs font-bold text-gray-900">Go to Feed</a>
      </div>
    <% } else { %>
      <% notifications.forEach(item => { %>
        <div class="notif-card bg-white p-3.5 rounded-2xl border border-gray-100 flex items-center justify-between gap-3 shadow-sm <%= item.read ? 'opacity-90' : 'ring-2 ring-[#bee84a]/50' %>">
          <div class="flex items-center gap-3 flex-1 min-w-0">
            <!-- Icon Badge based on type -->
            <div class="relative flex-shrink-0">
              <div class="w-11 h-11 rounded-full bg-gray-100 flex items-center justify-center font-bold text-gray-700 text-sm overflow-hidden ring-2 ring-[#bee84a]">
                <span class="capitalize"><%= item.senderID.slice(0, 2) %></span>
              </div>
              <span class="absolute -bottom-1 -right-1 w-5 h-5 rounded-full flex items-center justify-center text-[10px] shadow
                <%= item.type === 'like' ? 'bg-rose-500 text-white' : item.type === 'comment' ? 'bg-blue-500 text-white' : 'bg-emerald-500 text-white' %>">
                <% if (item.type === 'like') { %>❤️<% } else if (item.type === 'comment') { %>💬<% } else { %>👤<% } %>
              </span>
            </div>

            <!-- Content -->
            <div class="flex flex-col flex-1 min-w-0">
              <div class="text-sm text-gray-800 leading-tight">
                <span class="font-bold text-gray-900">@<%= item.senderID %></span>
                <%= item.message ? item.message.replace(item.senderID, '').trim() : 'interacted with your profile' %>
              </div>
              <span class="text-[11px] text-gray-400 mt-1">
                <%= new Date(item.createdAt).toLocaleDateString(undefined, { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
              </span>
            </div>
          </div>

          <!-- Action / context link -->
          <div class="flex-shrink-0">
            <% if (item.type === 'follow') { %>
              <a href="/profile" class="text-xs px-3 py-1.5 bg-[#f4ff26] font-semibold rounded-full hover:bg-[#bee84a] transition-colors">
                Profile
              </a>
            <% } else if (item.postID) { %>
              <a href="/post/<%= item.postID %>" class="text-xs px-3 py-1.5 bg-gray-100 text-gray-700 font-semibold rounded-full hover:bg-gray-200 transition-colors">
                View Post
              </a>
            <% } else { %>
              <a href="/" class="text-xs px-3 py-1.5 bg-gray-100 text-gray-700 font-semibold rounded-full hover:bg-gray-200 transition-colors">
                Feed
              </a>
            <% } %>
          </div>
        </div>
      <% }) %>
    <% } %>
  </main>

  <!-- ── BOTTOM NAVIGATION ──────────────────────────────────────────────────── -->
  <nav class="h-16 bg-white w-full fixed bottom-0 z-50 flex items-center justify-around rounded-t-2xl max-w-3xl border-t border-gray-200 px-3">
    <a href="/" class="flex flex-col items-center gap-0.5 cursor-pointer p-2 rounded-xl hover:bg-gray-100" title="Home">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
    </a>
    <a href="/profile/explore" class="flex flex-col items-center gap-0.5 cursor-pointer p-2 rounded-xl hover:bg-gray-100" title="Explore">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon></svg>
    </a>
    <a href="/events" class="flex flex-col items-center gap-0.5 cursor-pointer p-2 rounded-xl hover:bg-gray-100" title="Events">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
    </a>
    <a href="/notifications" class="flex flex-col items-center gap-0.5 cursor-pointer p-2 rounded-xl bg-[#f4ff26]" title="Notifications">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
    </a>
    <a href="/profile" class="flex flex-col items-center gap-0.5 cursor-pointer p-2 rounded-xl hover:bg-gray-100" title="Profile">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
    </a>
  </nav>

</body>
</html>
