<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= name %> (@<%= username %>) — Campus Connect</title>
  <link rel="stylesheet" href="/src/output.css">
  <style>
    .post-grid-item:hover .overlay { opacity: 1; }
  </style>
</head>

<body class="min-h-screen w-full flex items-center justify-start container m-auto flex-col relative max-w-3xl bg-gray-50 pb-24">

  <!-- ── COVER & HEADER ────────────────────────────────────────────────────── -->
  <div class="w-full relative h-48 sm:h-56 bg-gray-200">
    <img src="<%= coverImg %>" alt="Cover" class="w-full h-full object-cover">
    
    <!-- Top action bar -->
    <div class="absolute top-0 left-0 right-0 p-3 flex items-center justify-between z-10 bg-gradient-to-b from-black/60 to-transparent">
      <a href="/" class="p-2 rounded-full bg-white/80 hover:bg-white backdrop-blur text-gray-900 transition-colors shadow" title="Back to Feed">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
      </a>

      <div class="flex items-center gap-2">
        <!-- Change Cover Button -->
        <button id="openCoverModal" class="px-3 py-1.5 rounded-full bg-white/80 hover:bg-white backdrop-blur text-xs font-semibold text-gray-800 transition-all shadow flex items-center gap-1">
          📷 Cover
        </button>

        <!-- Logout -->
        <a href="/logout" class="p-2 rounded-full bg-white/80 hover:bg-rose-100 text-rose-600 backdrop-blur transition-colors shadow" title="Logout">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
            <polyline points="16 17 21 12 16 7"></polyline>
            <line x1="21" y1="12" x2="9" y2="12"></line>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <!-- ── PROFILE DETAILS SECTION ───────────────────────────────────────────── -->
  <div class="w-full bg-white px-4 pt-2 pb-5 border-b border-gray-200">
    <div class="flex items-end justify-between -mt-16 mb-3">
      <!-- Profile Picture -->
      <div id="userprofileImage" class="relative group cursor-pointer">
        <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-full ring-4 ring-white bg-white overflow-hidden shadow-md">
          <img class="w-full h-full object-cover" src="<%= profileImg %>" alt="<%= name %>">
        </div>
        <div class="absolute inset-0 bg-black/40 rounded-full opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center text-white text-[11px] font-semibold">
          Change
        </div>
      </div>

      <!-- Action: Edit Profile -->
      <button id="edit" class="px-4 py-2 rounded-full border border-gray-300 font-bold text-xs text-gray-800 hover:border-black hover:bg-gray-50 transition-all flex items-center gap-1.5 shadow-sm">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 20h9"></path>
          <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
        </svg>
        Edit Profile
      </button>
    </div>

    <!-- Name & Handle -->
    <div class="flex flex-col">
      <h1 class="text-xl font-extrabold text-gray-900 leading-tight"><%= name %></h1>
      <span class="text-xs text-gray-400">@<%= username %></span>
    </div>

    <!-- Campus Tags -->
    <% if (college || branch || year) { %>
      <div class="flex flex-wrap items-center gap-1.5 mt-2.5">
        <% if (college) { %>
          <span class="text-[11px] font-semibold bg-gray-100 text-gray-700 px-2.5 py-0.5 rounded-full">🏛️ <%= college %></span>
        <% } %>
        <% if (branch) { %>
          <span class="text-[11px] font-semibold bg-[#f4ff26]/50 text-gray-800 px-2.5 py-0.5 rounded-full">📚 <%= branch %></span>
        <% } %>
        <% if (year) { %>
          <span class="text-[11px] font-semibold bg-emerald-50 text-emerald-700 px-2.5 py-0.5 rounded-full">🎓 Year <%= year %></span>
        <% } %>
      </div>
    <% } %>

    <!-- Bio -->
    <% if (bio) { %>
      <p class="text-sm text-gray-700 mt-2.5 leading-relaxed whitespace-pre-line"><%= bio %></p>
    <% } else { %>
      <p class="text-xs text-gray-400 italic mt-2">No bio added yet. Click Edit Profile to add one!</p>
    <% } %>

    <!-- Social Links -->
    <% if (linkedin || github) { %>
      <div class="flex items-center gap-3 mt-3 pt-3 border-t border-gray-100 text-xs">
        <% if (linkedin) { %>
          <a href="<%= linkedin.startsWith('http') ? linkedin : 'https://' + linkedin %>" target="_blank" rel="noopener noreferrer" 
            class="flex items-center gap-1 font-semibold text-blue-600 hover:underline">
            <span>💼</span> LinkedIn
          </a>
        <% } %>
        <% if (github) { %>
          <a href="<%= github.startsWith('http') ? github : 'https://github.com/' + github %>" target="_blank" rel="noopener noreferrer" 
            class="flex items-center gap-1 font-semibold text-gray-800 hover:underline">
            <span>🐙</span> GitHub
          </a>
        <% } %>
      </div>
    <% } %>

    <!-- Metrics Row -->
    <div class="grid grid-cols-4 gap-2 mt-4 pt-3 border-t border-gray-100 text-center">
      <div class="flex flex-col">
        <span class="font-extrabold text-base text-gray-900"><%= post %></span>
        <span class="text-[11px] text-gray-500">Posts</span>
      </div>
      <div class="flex flex-col">
        <span class="font-extrabold text-base text-gray-900"><%= followers %></span>
        <span class="text-[11px] text-gray-500">Followers</span>
      </div>
      <div class="flex flex-col">
        <span class="font-extrabold text-base text-gray-900"><%= following %></span>
        <span class="text-[11px] text-gray-500">Following</span>
      </div>
      <div class="flex flex-col">
        <span class="font-extrabold text-base text-gray-900"><%= likes %></span>
        <span class="text-[11px] text-gray-500">Likes</span>
      </div>
    </div>
  </div>

  <!-- ── POSTS GRID ────────────────────────────────────────────────────────── -->
  <div class="w-full px-2 mt-3">
    <div class="flex items-center gap-2 px-2 pb-2 text-xs font-bold text-gray-500 uppercase tracking-wider">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
      Your Posts
    </div>

    <% if (totalposturl.length === 0) { %>
      <div class="text-center py-12 bg-white rounded-2xl border border-gray-200 p-6 shadow-sm">
        <div class="text-3xl mb-2">📸</div>
        <h3 class="font-bold text-sm text-gray-800">No posts shared yet</h3>
        <p class="text-xs text-gray-500 mt-1">Capture campus moments and share them with your peers!</p>
        <a href="/" class="mt-3 inline-block px-4 py-2 bg-gradient-to-r from-[#f4ff26] to-[#bee84a] rounded-full text-xs font-bold text-gray-900">Create First Post</a>
      </div>
    <% } else { %>
      <div class="grid grid-cols-3 gap-1.5 rounded-2xl overflow-hidden bg-white p-1 border border-gray-200">
        <% totalposturl.forEach(element => { %>
          <a href="/post/<%= element._id %>" class="post-grid-item relative aspect-square bg-gray-100 overflow-hidden group rounded-lg block cursor-pointer" title="View Post">
            <img class="w-full h-full object-cover" src="<%= element.postURL %>" alt="Post">
            <div class="overlay absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity p-2 flex flex-col items-center justify-center text-center text-white text-[11px] font-medium gap-1">
              <div class="flex items-center gap-2.5 font-bold text-xs">
                <span>❤️ <%= element.likeCount !== undefined ? element.likeCount : 0 %></span>
                <span>💬 <%= element.Comment || 0 %></span>
              </div>
              <% if (element.caption) { %>
                <span class="line-clamp-2 text-[10px] text-gray-200"><%= element.caption %></span>
              <% } %>
            </div>
          </a>
        <% }) %>
      </div>
    <% } %>
  </div>

  <!-- ── EDIT PROFILE MODAL ────────────────────────────────────────────────── -->
  <div id="editprofile" class="fixed inset-0 bg-black/50 z-[100] hidden items-center justify-center p-4 backdrop-blur-sm">
    <div class="bg-white w-full max-w-lg rounded-3xl p-6 shadow-2xl relative max-h-[90vh] overflow-y-auto">
      <div class="flex items-center justify-between pb-3 border-b border-gray-100">
        <h2 class="text-xl font-bold text-gray-900">Edit Profile</h2>
        <button id="closeEdit" class="p-1 rounded-full hover:bg-gray-100 text-gray-500">✕</button>
      </div>

      <div class="mt-4 flex flex-col gap-3">
        <div>
          <label class="block text-xs font-bold text-gray-700 mb-1">Display Name</label>
          <input id="newname" value="<%= name %>" type="text" class="w-full px-3 py-2 rounded-xl border border-gray-200 text-sm focus:outline-none focus:border-[#bee84a]">
        </div>

        <div>
          <label class="block text-xs font-bold text-gray-700 mb-1">Bio</label>
          <textarea id="newbio" rows="3" class="w-full px-3 py-2 rounded-xl border border-gray-200 text-sm focus:outline-none focus:border-[#bee84a]"><%= bio %></textarea>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
          <div>
            <label class="block text-xs font-bold text-gray-700 mb-1">College</label>
            <input id="college" value="<%= college %>" type="text" placeholder="e.g. IIT Delhi" class="w-full px-3 py-2 rounded-xl border border-gray-200 text-sm focus:outline-none focus:border-[#bee84a]">
          </div>
          <div>
            <label class="block text-xs font-bold text-gray-700 mb-1">Branch</label>
            <input id="branch" value="<%= branch %>" type="text" placeholder="e.g. CSE / ECE" class="w-full px-3 py-2 rounded-xl border border-gray-200 text-sm focus:outline-none focus:border-[#bee84a]">
          </div>
          <div>
            <label class="block text-xs font-bold text-gray-700 mb-1">Year</label>
            <input id="year" value="<%= year %>" type="text" placeholder="e.g. 2nd / 2026" class="w-full px-3 py-2 rounded-xl border border-gray-200 text-sm focus:outline-none focus:border-[#bee84a]">
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <div>
            <label class="block text-xs font-bold text-gray-700 mb-1">LinkedIn Profile</label>
            <input id="linkedin" value="<%= linkedin %>" type="text" placeholder="linkedin.com/in/username" class="w-full px-3 py-2 rounded-xl border border-gray-200 text-sm focus:outline-none focus:border-[#bee84a]">
          </div>
          <div>
            <label class="block text-xs font-bold text-gray-700 mb-1">GitHub Username / URL</label>
            <input id="github" value="<%= github %>" type="text" placeholder="github.com/username" class="w-full px-3 py-2 rounded-xl border border-gray-200 text-sm focus:outline-none focus:border-[#bee84a]">
          </div>
        </div>

        <button id="saveContinue" class="mt-2 w-full py-3 bg-gradient-to-r from-[#f4ff26] to-[#bee84a] rounded-xl font-bold text-sm text-gray-900 shadow hover:opacity-95 transition-all">
          Save Changes
        </button>
      </div>
    </div>
  </div>

  <!-- ── UPLOAD PROFILE PIC MODAL ───────────────────────────────────────────── -->
  <div id="editImage" class="fixed inset-0 bg-black/50 z-[100] hidden items-center justify-center p-4 backdrop-blur-sm">
    <div class="bg-white w-full max-w-sm rounded-3xl p-6 shadow-2xl relative">
      <div class="flex items-center justify-between pb-3 border-b border-gray-100">
        <h2 class="text-base font-bold text-gray-900">Upload Profile Photo</h2>
        <button id="editImageClose" class="p-1 rounded-full hover:bg-gray-100 text-gray-500">✕</button>
      </div>
      <form action="/file/upload" method="post" enctype="multipart/form-data" class="mt-4 flex flex-col gap-3">
        <input type="file" name="file" accept="image/*" required class="text-xs text-gray-500 file:mr-3 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-xs file:font-semibold file:bg-[#f4ff26] file:text-gray-800 hover:file:bg-[#bee84a]">
        <button type="submit" class="w-full py-2.5 bg-gradient-to-r from-[#f4ff26] to-[#bee84a] rounded-xl font-bold text-xs text-gray-900 shadow mt-2">
          Update Photo
        </button>
      </form>
    </div>
  </div>

  <!-- ── UPLOAD COVER PHOTO MODAL ───────────────────────────────────────────── -->
  <div id="coverModal" class="fixed inset-0 bg-black/50 z-[100] hidden items-center justify-center p-4 backdrop-blur-sm">
    <div class="bg-white w-full max-w-sm rounded-3xl p-6 shadow-2xl relative">
      <div class="flex items-center justify-between pb-3 border-b border-gray-100">
        <h2 class="text-base font-bold text-gray-900">Upload Cover Banner</h2>
        <button id="closeCoverModal" class="p-1 rounded-full hover:bg-gray-100 text-gray-500">✕</button>
      </div>
      <form action="/file/upload/cover" method="post" enctype="multipart/form-data" class="mt-4 flex flex-col gap-3">
        <input type="file" name="file" accept="image/*" required class="text-xs text-gray-500 file:mr-3 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-xs file:font-semibold file:bg-[#f4ff26] file:text-gray-800 hover:file:bg-[#bee84a]">
        <button type="submit" class="w-full py-2.5 bg-gradient-to-r from-[#f4ff26] to-[#bee84a] rounded-xl font-bold text-xs text-gray-900 shadow mt-2">
          Update Cover
        </button>
      </form>
    </div>
  </div>

  <!-- ── BOTTOM NAVIGATION ──────────────────────────────────────────────────── -->
  <nav class="h-16 bg-white w-full fixed bottom-0 z-50 flex items-center justify-around rounded-t-2xl max-w-3xl border-t border-gray-200 px-3">
    <a href="/" class="flex flex-col items-center gap-0.5 cursor-pointer p-2 rounded-xl hover:bg-gray-100" title="Home">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
    </a>
    <a href="/profile/explore" class="flex flex-col items-center gap-0.5 cursor-pointer p-2 rounded-xl hover:bg-gray-100" title="Explore">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon></svg>
    </a>
    <a href="/events" class="flex flex-col items-center gap-0.5 cursor-pointer p-2 rounded-xl hover:bg-gray-100" title="Events">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
    </a>
    <a href="/notifications" class="flex flex-col items-center gap-0.5 cursor-pointer p-2 rounded-xl hover:bg-gray-100" title="Notifications">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
    </a>
    <a href="/profile" class="flex flex-col items-center gap-0.5 cursor-pointer p-2 rounded-xl bg-[#f4ff26]" title="Profile">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
    </a>
  </nav>

  <script src="/js/profileScript.js"></script>
</body>
</html>